#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB        &kp Q &kp W &kp E &kp R &kp T        &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSLH
                &mt LSHFT BSPC &kp A &kp S &kp D &kp F &kp G        &kp H &kp J  &kp K     &kp L   &kp SEMI &mt RSHFT SQT
                &kp LGUI       &kp Z &kp X &kp C &kp V &kp B        &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                              &kp LALT &lt 2 SPACE &mt LCTRL RET     &mt RCTRL BSPC &lt 1 SPACE &mt RALT DEL
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &kp LBRC  &kp RBRC    &trans &kp HOME       &kp UP       &kp END   &trans &trans
                &trans &trans          &kp PSCRN    &trans       &kp LPAR  &kp RPAR    &trans &kp LEFT       &kp DOWN     &kp RIGHT &trans &trans
                &trans &studio_unlock  &trans       &kp C_AL_CALC &kp LBKT &kp RBKT    &trans &kp RC(RS(TAB)) &kp RC(TAB) &trans    &trans &trans
                                                        &trans    &trans    &trans      &trans &trans          &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5      &kp N6       &kp N7 &kp N8 &kp N9 &kp N0    &kp F12
                &trans    &trans &trans &trans &trans &trans         &kp KP_PLUS  &kp N4 &kp N5 &kp N6 &kp EQUAL &kp DEL
                &trans    &trans &trans &trans &trans &trans         &kp KP_MINUS &kp N1 &kp N2 &kp N3 &kp UNDER &trans
                                        &trans &trans &trans        &trans       &kp N0 &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &mo TAB   &trans  &kp F7 &kp F8 &kp F9  &kp F12   &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans &trans &kp BSPC
                &kp LCTRL &trans  &kp F4 &kp F5 &kp F6  &kp F11   &trans       &trans     &trans       &trans &trans &trans
                &bt LSHFT &kp F1 &kp F2 &kp F3 &kp F10 &trans     &trans       &trans     &trans       &trans &trans &kp LGUI
                                    &mo 1 &kp SPACE &kp RET        &mo 2        &kp RALT   &none
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};